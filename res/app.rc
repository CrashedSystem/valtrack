1 ICON "app.ico"

// Keep FILEVERSION in sync with Cargo.toml. Explorer, Defender and any
// "is this exe signed/known" heuristics read this block; a binary without it
// looks like an unnamed packer output.
1 VERSIONINFO
FILEVERSION 0,1,1,0
PRODUCTVERSION 0,1,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CrashedSystem"
      VALUE "FileDescription", "VALORANT live-match tracker (no Overwolf)"
      VALUE "FileVersion", "0.1.1"
      VALUE "InternalName", "valtrack"
      VALUE "LegalCopyright", "GPL-3.0-only"
      VALUE "OriginalFilename", "valtrack.exe"
      VALUE "ProductName", "valtrack"
      VALUE "ProductVersion", "0.1.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
